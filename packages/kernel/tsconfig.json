{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "exactOptionalPropertyTypes": true, "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true, "verbatimModuleSyntax": true, "isolatedModules": true,
    "declaration": true, "declarationMap": true, "sourceMap": true, "composite": true,
    "outDir": "dist", "rootDir": "src", "skipLibCheck": true
  },
  "references": [{ "path": "../contracts" }],
  "include": ["src/**/*.ts"]
}
