{
  "name": "@distlab/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "npm run build:packages --prefix ../.. --silent && tsc --noEmit",
    "test": "npm run typecheck && node --test --experimental-strip-types tests/*.test.ts && npm run test:browser",
    "test:browser": "playwright test",
    "test:boundaries": "node --test --experimental-strip-types tests/boundaries.test.ts"
  },
  "dependencies": {
    "@distlab/catalogs": "0.0.0",
    "@distlab/contracts": "0.0.0",
    "@distlab/kernel": "0.0.0",
    "@distlab/scenario": "0.0.0",
    "@xyflow/react": "^12.11.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vite": "^7.3.6"
  }
}
